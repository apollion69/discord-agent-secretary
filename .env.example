# discord-agent-secretary — environment configuration
# Copy to .env and fill in. Never commit .env.

# === Backend selector ===
# Which issue tracker to drive. Supported: multica | github | linear | jira
BACKEND=multica

# === Discord ===
# From Discord Dev Portal → Bot → Reset Token
DISCORD_BOT_TOKEN=

# Guild (server) ID where slash commands are registered during development.
# Guild-scoped commands sync instantly; global registration takes up to an hour.
DISCORD_GUILD_ID=

# Channel IDs where the bot reads messages for LLM-secretary mode (P5).
# Comma-separated list of numeric IDs, optional.
DISCORD_WATCH_CHANNELS=

# === Multica backend (BACKEND=multica) ===
# Target Multica workspace UUID. REQUIRED when BACKEND=multica.
MULTICA_WORKSPACE_ID=your-workspace-uuid-here

# Default assignee user/agent ID for bot-created issues
MULTICA_DEFAULT_ASSIGNEE=

# Absolute path to the multica CLI binary. Autodetected from PATH when empty.
MULTICA_CLI_PATH=

# Maps Discord user IDs to Multica member user UUIDs so /task is attributed to
# the real requester (act-as-member). JSON object; unmapped users fall back to
# the bot token owner. The bot token must belong to an owner/admin member for
# attribution to take effect.
# DISCORD_MEMBER_MAP={"111111111111111111":"<member-uuid>","222222222222222222":"<member-uuid>"}
DISCORD_MEMBER_MAP={}

# Per-call timeout in seconds for the CLI subprocess
MULTICA_CLI_TIMEOUT=8

# Per-call cap on combined stdout/stderr bytes; over this the CLI is killed.
MULTICA_CLI_OUTPUT_BYTE_LIMIT=10485760

# === GitHub backend (BACKEND=github) ===
# GitHub fine-grained PAT or App-installation token with `Issues: Read & Write`.
GITHUB_TOKEN=

# Target repository in `owner/repo` form, e.g. `apollion69/my-project`.
GITHUB_REPO=

# === Linear backend (BACKEND=linear) ===
# Linear personal API key (Settings → API → Personal API keys).
LINEAR_API_KEY=

# Target Linear team UUID.
LINEAR_TEAM_ID=

# === Jira backend (BACKEND=jira) ===
# Cloud: https://yoursite.atlassian.net | Server/DC: https://jira.your-host
JIRA_BASE_URL=

# Cloud auth: account email + API token. Server/DC: any email + PAT.
JIRA_EMAIL=
JIRA_API_TOKEN=

# Project key (the prefix on issue keys, e.g. `ABC` for `ABC-123`)
JIRA_PROJECT_KEY=

# === Anthropic (optional — LLM fallback when regex confidence < 0.9; v0.2+) ===
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# === Backend resilience ===
# Consecutive failures before a backend's circuit breaker opens (range 1-100).
BACKEND_CIRCUIT_FAILURE_THRESHOLD=5
# Seconds to wait before the open circuit moves to half-open (range 1-600).
BACKEND_CIRCUIT_RESET_TIMEOUT=30

# === Webhook (Multica → Discord review notifications) ===
# HMAC-SHA256 secret matching the secret configured in Multica workspace webhooks.
# Multica sends X-Multica-Signature: sha256=<hex> header; empty = no verification.
# Generate: openssl rand -hex 32
MULTICA_WEBHOOK_SECRET=

# Discord channel ID where "Готово к ревью" notifications are posted.
# Required for review notifications to work; optional if only using task creation.
DISCORD_REVIEW_CHANNEL_ID=

# === Pull poller (review notifications without outgoing webhooks) ===
# Seconds between in_review poll cycles (default 30, min 5).
MULTICA_POLL_INTERVAL=30

# Path to the JSON dedup file. Must be writable by the service user.
# /opt/discord-secretary/seen.json is writable via ReadWritePaths in the systemd unit.
MULTICA_SEEN_PATH=/opt/discord-secretary/seen.json

# Base URL of the Multica web UI — constructs clickable issue links in Discord.
# Example: http://ansible-lx1.mgmt.local:3000  Leave empty = plain text identifiers.
MULTICA_APP_URL=

# === Autopilot digest ===
# Cron/autopilot (origin_type=autopilot) issues are NOT pinged per-task; instead
# one daily summary is posted to the review channel. Set DIGEST_ENABLED=false to
# disable entirely (autopilot tasks then produce no notifications at all).
DIGEST_ENABLED=true
# Local hour (0-23, in TZ) to post the daily digest.
DIGEST_HOUR=9

# === Mention notifications ===
# When an agent/teammate @mentions a mapped member in a Multica comment, ping that
# member in the review channel (uses DISCORD_MEMBER_MAP to resolve the Discord user).
MENTION_SCAN_ENABLED=true
# Issue statuses whose comments are scanned (CSV). Active work only, to bound load.
MENTION_SCAN_STATUSES=todo,in_progress,in_review,blocked

# === Healthcheck ===
# TCP port for /livez, /readyz, and POST /hooks/multica endpoints; 0 disables.
# Useful in Kubernetes / systemd; 0 keeps the bot a pure outbound process.
HEALTHCHECK_PORT=0

# === Runtime ===
LOG_LEVEL=INFO
LOG_FORMAT=json        # json | console
TZ=Europe/Moscow
