# discord-agent-secretary — environment configuration
# Copy to .env and fill in. Never commit .env.

# === Backend selector ===
# Which issue tracker to drive. Supported: multica | github | linear | jira
BACKEND=multica

# === Discord ===
# From Discord Dev Portal → Bot → Reset Token
DISCORD_BOT_TOKEN=

# Guild (server) ID where slash commands are registered during development.
# Guild-scoped commands sync instantly; global registration takes up to an hour.
DISCORD_GUILD_ID=

# Channel IDs where the bot reads messages for LLM-secretary mode (P5).
# Comma-separated list of numeric IDs, optional.
DISCORD_WATCH_CHANNELS=

# === Multica backend (BACKEND=multica) ===
# Target Multica workspace UUID. REQUIRED when BACKEND=multica.
MULTICA_WORKSPACE_ID=your-workspace-uuid-here

# Default assignee user/agent ID for bot-created issues
MULTICA_DEFAULT_ASSIGNEE=

# Absolute path to the multica CLI binary. Autodetected from PATH when empty.
MULTICA_CLI_PATH=

# Per-call timeout in seconds for the CLI subprocess
MULTICA_CLI_TIMEOUT=8

# === GitHub backend (BACKEND=github) ===
# GitHub fine-grained PAT or App-installation token with `Issues: Read & Write`.
GITHUB_TOKEN=

# Target repository in `owner/repo` form, e.g. `apollion69/my-project`.
GITHUB_REPO=

# === Linear backend (BACKEND=linear) ===
# Linear personal API key (Settings → API → Personal API keys).
LINEAR_API_KEY=

# Target Linear team UUID.
LINEAR_TEAM_ID=

# === Jira backend (BACKEND=jira) ===
# Cloud: https://yoursite.atlassian.net | Server/DC: https://jira.your-host
JIRA_BASE_URL=

# Cloud auth: account email + API token. Server/DC: any email + PAT.
JIRA_EMAIL=
JIRA_API_TOKEN=

# Project key (the prefix on issue keys, e.g. `ABC` for `ABC-123`)
JIRA_PROJECT_KEY=

# === Anthropic (optional — LLM fallback when regex confidence < 0.9; v0.2+) ===
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# === Runtime ===
LOG_LEVEL=INFO
LOG_FORMAT=json        # json | console
TZ=Europe/Moscow
